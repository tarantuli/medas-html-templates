{
  "name": "morphp/medas-html-templates",
  "description": "Medas HTML templates",
  "keywords": [
    "frontend"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "ext-dom": "*",
    "ext-libxml": "*",
    "morphp/medas-core": "^4",
    "scssphp/scssphp": "^2.1"
  },
  "require-dev": {
    "morphp/medas-config-manager": "^3",
    "morphp/medas-config-options": "^3",
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\HtmlTemplates\\": "src/"
    }
